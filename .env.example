# Database
DATABASE_URL="your_postgres_connection_string"

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="InsiderTrack Pro <noreply@insidertrack.pro>"

# Application URL (used in email links)
# Change to your custom domain in production (e.g., https://yourdomain.com)
APP_URL=http://localhost:5000

# OpenAI API (for AI analysis)
OPENAI_API_KEY=your_openai_api_key

# Stripe Configuration (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_ID_YEARLY=price_your_yearly_price_id

# Frontend URL (for Stripe redirects)
# Change to your custom domain in production (e.g., https://yourdomain.com)
FRONTEND_URL=http://localhost:5000

# Stripe Public Key (Frontend - with VITE_ prefix for Vite)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key

# Other environment variables
NODE_ENV=development
PORT=5000